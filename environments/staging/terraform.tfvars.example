# =============================================================================
# STAGING ENVIRONMENT - TERRAFORM.TFVARS EXAMPLE
# =============================================================================
# Copy this file to terraform.tfvars and update the values as needed

# GCP Configuration
project_id = "your-staging-project-id"
region     = "us-central1"
zone       = "us-central1-a"

# Network Configuration
network_name        = "nginx-vpc-staging"
public_subnet_cidr  = "10.1.0.0/24"
private_subnet_cidr = "10.1.1.0/24"
proxy_subnet_cidr   = "10.1.2.0/24"

# NGINX Instance Configuration - Staging optimized
nginx_machine_type   = "e2-small"
nginx_source_image   = "projects/debian-cloud/global/images/family/debian-11"
nginx_disk_size_gb   = 20
nginx_instance_count = 3

# Core Instance Configuration - Staging optimized
core_machine_type   = "e2-small"
core_source_image   = "projects/debian-cloud/global/images/family/debian-11"
core_disk_size_gb   = 20
core_instance_count = 3

# Load Balancer Configuration
health_check_interval           = 5
health_check_timeout           = 5
health_check_healthy_threshold = 2
health_check_unhealthy_threshold = 2
session_affinity               = "NONE"
backend_timeout_sec            = 30

# DNS Configuration
dns_zone_name = "test-internal-zone-staging"
dns_zone_dns_name = "staging.internal."
dns_record_ttl = 300
create_nginx_dns_record = false
create_core_instances_dns_record = false
core_instances_ips = [] 